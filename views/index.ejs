<section class="card">
	<h2>Scanner une zone</h2>
	<form id="prospectForm">
		<label>Secteurs d'activité</label>
		<div id="type-selector" class="chips-container">
			<div class="chip" data-value="hotel">Hôtels</div>
			<div class="chip" data-value="travel_agency">Agences de Voyage</div>
			<div class="chip" data-value="laundry">Pressings / Buanderies</div>
			<div class="chip" data-value="storage">Garde-meubles</div>
			<div class="chip" data-value="car_wash">Lavage Auto</div>
			<div class="chip" data-value="clothing_store">Prêt-à-porter</div>
			<div class="chip" data-value="jewelry_store">Bijouteries</div>
			<div class="chip" data-value="florist">Fleuristes</div>
			<div class="chip" data-value="pet_store">Animaleries</div>
			<div class="chip" data-value="shoe_store">Magasins de chaussures</div>
			<div class="chip" data-value="home_goods_store">Décoration</div>
			<div class="chip" data-value="bicycle_store">Magasins de vélos</div>
			<div class="chip" data-value="book_store">Librairies</div>
			<div class="chip" data-value="car_repair">Garages</div>
			<div class="chip" data-value="electrician">Électriciens</div>
			<div class="chip" data-value="plumber">Plombiers</div>
			<div class="chip" data-value="locksmith">Serruriers</div>
			<div class="chip" data-value="painter">Peintres</div>
			<div class="chip" data-value="carpenter">Menuisiers</div>
			<div class="chip" data-value="real_estate_agency">Agences Immo</div>
			<div class="chip" data-value="moving_company">Déménageurs</div>
		</div>

		<label for="radius">Rayon de recherche (mètres)</label>
		<input type="number" name="radius" id="radius" value="2000" min="100" required />

		<div style="display: flex; gap: 10px">
			<div style="flex: 1">
				<label>Latitude</label>
				<input type="number" id="lat" step="any" required readonly placeholder="Localisation..." />
			</div>
			<div style="flex: 1">
				<label>Longitude</label>
				<input type="number" id="lng" step="any" required readonly placeholder="Localisation..." />
			</div>
		</div>

		<button type="submit" id="btnScan" class="btn-action">Lancer le scan</button>
	</form>
</section>

<div id="resultsContainer"></div>
